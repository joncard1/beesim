<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.*?>
<?import java.lang.*?>
<?import beesimulator.ui.MainController.ComboSelections?>
<?import beesimulator.ui.MainController.ComboSelections.*?>

<StackPane fx:controller="beesimulator.ui.MainController" xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/2.2" prefHeight="500.0" prefWidth="400.0" stylesheets="beesimulator/ui/beecharts.css" >
  <children>
    <BorderPane fx:id="borderPaneDelegate">
      <padding><Insets top="20" bottom="20" right="20" left="20" /></padding>
      <top>
        <VBox>
          <GridPane vgap="5" hgap="5">
            <children>
              <Text text="Simulation" styleClass="headerLabel" GridPane.rowIndex="0" GridPane.columnIndex="0" />
              <ComboBox fx:id="simulatorSelectionComboBoxDelegate" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <items>
                  <FXCollections fx:factory="observableArrayList" />
                </items>
              </ComboBox>
              <Text text="Summary type" styleClass="headerLabel" GridPane.rowIndex="1" GridPane.columnIndex="0" />
              <ComboBox fx:id="processorSelectionComboBoxDelegate" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <items>
                  <FXCollections fx:factory="observableArrayList">
                    <MainController.ComboSelections fx:factory="valueOf" fx:value="Histogram" />
                    <MainController.ComboSelections fx:factory="valueOf" fx:value="Cumulative" />
                  </FXCollections>
                </items>
              </ComboBox>
            </children>
          </GridPane>
          <ScrollPane fx:id="scrollPane" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true">
            <content>
              <HBox fx:id="beeChartsBoxDelegate" />
            </content>
          </ScrollPane>
        </VBox>
      </top>
      <right>
        <HBox>
          <VBox>
            <Slider fx:id="heatFlowSliderDelegate" orientation="VERTICAL" VBox.vgrow="ALWAYS" blockIncrement="0.1" />
            <Text fx:id="heatFlowTextDelegate" />
          </VBox>
          <VBox>
            <Slider fx:id="heatPerBeeSliderDelegate" orientation="VERTICAL" VBox.vgrow="ALWAYS" blockIncrement="0.0001" />
            <Text fx:id="heatPerBeeTextDelegate" />
          </VBox>
        </HBox>
      </right>
      <center>
        <LineChart fx:id="temperatureChartDelegate" layoutX="-2.0" prefHeight="500.0" prefWidth="500.0" animated="false">
          <xAxis>
            <NumberAxis label="Time" side="BOTTOM" />
          </xAxis>
          <yAxis>
            <NumberAxis fx:id="yAxisDelegate" label="Temperature" side="LEFT" tickUnit="0.1" animated="false" autoRanging="false" forceZeroInRange="false" />
          </yAxis>
        </LineChart>
      </center>
      <bottom>
        <!-- Shows why the charts stopped updating if a simulation run fails.
             It takes no space while there is no error. -->
        <Label fx:id="errorLabelDelegate" styleClass="error-message" wrapText="true" visible="false" managed="false" />
      </bottom>
    </BorderPane>
  </children>
</StackPane>